#!/bin/sh
# Generate a README for every newly-committed solution that doesn't have one.
#
# This runs on your machine against the Claude Code session you're already
# logged into, so there is no token to configure and no API cost. Generated
# .md files are added to the commit alongside the solution.
#
# Installed via `git config core.hooksPath .githooks`.
# Skip a single commit with: SKIP_README=1 git commit ...

[ -n "$SKIP_README" ] && exit 0
command -v claude >/dev/null 2>&1 || exit 0   # no CLI here, let CI handle it

# Only files being added in THIS commit, under the two solution directories.
staged=$(git diff --cached --name-only --diff-filter=A \
         | grep -E '^(codeforces|cses)/.*\.(cpp|cc|cxx)$' || true)
[ -z "$staged" ] && exit 0

for f in $staged; do
  md="${f%.*}.md"
  [ -f "$md" ] && continue
  case "$(basename "$f")" in Template.*) continue ;; esac

  printf 'README for %s ... ' "$f"
  if node .github/scripts/gen-readme.js "$f" >/dev/null 2>&1 && [ -f "$md" ]; then
    git add "$md"
    echo "ok"
  else
    # Not fatal: the commit proceeds and CI (or the next commit) can retry.
    echo "skipped"
  fi
done

exit 0
